  "flashCards_role_sdr": {
    "source": "illustrative",
    "cards": [
      {
        "id": "c1",
        "status": "approved",
        "category": "role_knowledge",
        "question": "What does a Sales Development Rep do day to day?",
        "strong": [
          "Names prospecting, outreach and qualifying",
          "Links the work to booking meetings for account executives"
        ],
        "tip": "Describe a real day, not a job ad.",
        "mistakes": [
          "Describing closing deals as the main job"
        ]
      },
      {
        "id": "c2",
        "status": "approved",
        "category": "motivation",
        "question": "Why do you want to work in sales?",
        "strong": [
          "A specific reason grounded in experience",
          "Shows comfort with targets and feedback"
        ],
        "tip": "Be specific about what draws you in.",
        "mistakes": [
          "Talking only about money"
        ]
      },
      {
        "id": "c3",
        "status": "approved",
        "category": "behavioural",
        "question": "Tell me about a time you kept going after hearing no.",
        "strong": [
          "Clear situation and goal",
          "What you changed after each no",
          "The result and what you learned"
        ],
        "tip": "Use STAR: situation, task, action, result.",
        "mistakes": [
          "No concrete outcome"
        ]
      },
      {
        "id": "c4",
        "status": "ai_draft",
        "category": "situational",
        "question": "A prospect says “Just send me an email.” What do you do next?",
        "strong": [
          "Acknowledge the request without arguing",
          "Ask one short question about what matters to them",
          "Offer a short, specific email and a time to reconnect",
          "Log the call and next step in the CRM"
        ],
        "tip": "One question, one clear next step.",
        "mistakes": [
          "Sending a generic email and moving on",
          "Pushing for a meeting after a clear no",
          "Listing features instead of their needs"
        ]
      },
      {
        "id": "c5",
        "status": "ai_draft",
        "category": "role_knowledge",
        "question": "How would you research an account before a first call?",
        "strong": [
          "Company news and priorities",
          "The contact’s role and likely goals"
        ],
        "tip": "Ten focused minutes beats an hour of browsing.",
        "mistakes": [
          "Reading the website and nothing else"
        ]
      },
      {
        "id": "c6",
        "status": "ai_draft",
        "category": "behavioural",
        "question": "Describe a goal you reached by being organised and consistent.",
        "strong": [
          "A measurable goal",
          "The routine you kept",
          "The outcome"
        ],
        "tip": "Show the system, not just the effort.",
        "mistakes": [
          "Vague timelines"
        ]
      },
      {
        "id": "c7",
        "status": "ai_draft",
        "category": "situational",
        "question": "A prospect asks a technical question you can’t answer. How do you respond?",
        "strong": [
          "Be honest that you’ll check",
          "Offer a specialist or a follow-up time"
        ],
        "tip": "Honesty builds trust faster than guessing.",
        "mistakes": [
          "Guessing an answer"
        ]
      },
      {
        "id": "c8",
        "status": "ai_draft",
        "category": "role_knowledge",
        "question": "What makes a lead qualified?",
        "strong": [
          "Need, authority, timing and budget",
          "Signals you would listen for"
        ],
        "tip": "Name the signals, not just the acronym.",
        "mistakes": [
          "Treating any interest as qualified"
        ]
      }
    ]
  },
  "questions_role_csa": {
    "source": "illustrative",
    "note": "Only q1 text and its 48 → 69 averages come from the brief.",
    "items": [
      {
        "id": "q1",
        "text": "Tell me about a time you handled an upset customer.",
        "category": "behavioural",
        "difficulty": "medium",
        "status": "approved",
        "timesAsked": 52,
        "avgFirst": 48,
        "avgSecond": 69,
        "avgLearning": 74,
        "rubric": {
          "keyPoints": [
            {
              "point": "Acknowledges how the customer feels",
              "example": "I let her explain everything before I said anything."
            },
            {
              "point": "Takes ownership of the problem",
              "example": "I told him I’d stay with it until it was fixed."
            },
            {
              "point": "Explains the concrete steps taken",
              "example": "I checked the order history and found the delay."
            },
            {
              "point": "States the outcome and follow-up",
              "example": "I called back the next day to confirm it arrived."
            }
          ],
          "redFlags": [
            "Blames the customer or colleagues",
            "No clear outcome",
            "Promises something outside policy"
          ],
          "expectedStructure": "star"
        },
        "testEvaluation": {
          "answer": "In my last job at a phone shop, a customer came in angry because his repair was late for the second time. I let him finish, apologised, and said I’d sort it. I checked the system, saw the part was stuck at the warehouse, and called them while he waited. They could deliver the next morning, so I lent him a phone. He left calmer.",
          "score": 74,
          "band": "nearly",
          "subScores": {
            "content": 78,
            "structure": 70,
            "delivery": 66,
            "relevance": 80
          },
          "matched": [
            "acknowledges feelings",
            "takes ownership",
            "concrete steps"
          ],
          "issues": [
            "outcome is vague and there’s no follow-up"
          ],
          "candidateFeedback": "You stayed calm, took ownership and explained clear steps. To make it stronger, end with a specific result: what changed for the customer, and how you checked they were happy."
        }
      },
