      "label": "Interview ready",
      "min": 85,
      "max": 100
    },
    "nearly": {
      "label": "Nearly ready",
      "min": 70,
      "max": 84
    },
    "developing": {
      "label": "Developing",
      "min": 50,
      "max": 69
    },
    "not-ready": {
      "label": "Not ready yet",
      "min": 0,
      "max": 49
    }
  },
  "font": {
    "family": "\"Plus Jakarta Sans\", Inter, system-ui, sans-serif",
    "title": "600 20px/28px var(--font-sans)",
    "section": "600 16px/24px var(--font-sans)",
    "body": "400 14px/22px var(--font-sans)",
    "cell": "400 14px/20px var(--font-sans)",
    "small": "400 13px/20px var(--font-sans)",
    "header": "600 12px/16px var(--font-sans)",
    "meta": "400 12px/16px var(--font-sans)",
    "numeric": "tabular-nums"
  },
  "space": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "24px",
    "space-6": "32px",
    "space-7": "48px"
  },
  "size": {
    "sidebar-width": "240px",
    "sidebar-width-collapsed": "64px",
    "panel-width": "560px",
    "modal-width": "640px",
    "dialog-width": "460px",
    "row-height": "44px",
    "row-height-2line": "52px",
    "header-row-height": "40px",
    "control-height": "36px",
    "control-height-sm": "32px",
    "chip-height": "24px",
    "hit-min": "44px"
  },
  "radius": {
    "radius": "8px",
    "radius-sm": "6px",
    "radius-chip": "999px",
    "radius-card": "12px"
  },
  "shadow": {
    "panel": {
      "light": "0 12px 32px rgba(31, 41, 55, 0.16)",
      "dark": "0 12px 32px rgba(0, 0, 0, 0.5)"
    },
    "menu": {
      "light": "0 8px 24px rgba(31, 41, 55, 0.12)",
      "dark": "0 8px 24px rgba(0, 0, 0, 0.45)"
    }
  },
  "focus": {
    "ring": "2px solid primary",
    "offset": "2px (controls), -2px (rows)"
  }
